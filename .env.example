# FeatherLM server configuration (copy to .env). Developed by Ammad Aslam with AI-assisted tooling.
# Keys: leave empty for local use. In any network-facing deployment set both.
FEATHERLM_API_KEY=
FEATHERLM_ADMIN_KEY=
# Disable training/admin endpoints entirely (recommended for public servers)
FEATHERLM_ENABLE_TRAINING_API=true
# Storage
FEATHERLM_MODELS_DIR=models
FEATHERLM_RUNS_DIR=runs
FEATHERLM_DATA_DIR=data
FEATHERLM_DB=featherlm.db
# Runtime
FEATHERLM_DEFAULT_MODEL=
FEATHERLM_THREADS=0
FEATHERLM_MAX_NEW_TOKENS=512
FEATHERLM_MAX_LOADED_MODELS=2
FEATHERLM_MAX_REQUEST_BYTES=1000000
FEATHERLM_BUSY_TIMEOUT_S=30
# Training limits applied to API-started jobs
FEATHERLM_MAX_TRAINING_JOBS=1
FEATHERLM_MAX_TRAINING_STEPS=20000
FEATHERLM_TRAINING_MEMORY_BUDGET_MB=3000
# Comma-separated origins allowed by CORS (the bundled Studio is same-origin and needs none)
FEATHERLM_CORS_ORIGINS=http://localhost:5173
FEATHERLM_LOG_LEVEL=INFO
